      .str.lower()
      .str.replace(" ", "_")
)

df.columns

df["status"].value_counts()

df['tumor_size_category'] = pd.cut(
    df['tumor_size'],
    bins=[0, 20, 50, float('inf')],
    labels=['Small', 'Medium', 'Large'],
    include_lowest=True
)
df

df.describe()

df.columns

sns.histplot(df["age"], bins=20, kde=True)
